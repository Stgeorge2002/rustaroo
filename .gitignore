# Ignore everything unless it is explicitly part of the product.
*

# Application manifests, project documentation and licensing.
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/README.md
!/LICENSE
!/LICENSE.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/rust-toolchain.toml
!/rustfmt.toml
!/clippy.toml
!/bench.sh
!/.env.example
!/.env.sample
!/.env.template

# Rust source and tests. Other source assets need an explicit rule.
!/src/
!/src/**/
!/src/**/*.rs
!/tests/
!/tests/**/
!/tests/**/*.rs

# Deliberately versioned fixtures; local biological datasets stay excluded.
!/tests/fixtures/
!/tests/fixtures/**

# Cargo configuration, never registry credentials.
!/.cargo/
!/.cargo/config.toml

# Benchmark scripts, their tests and documentation.
!/benchmarks/
!/benchmarks/*.py
!/benchmarks/*.md
!/benchmarks/panaroo.Dockerfile

# Container recipes and documentation, not images or downloaded tools.
!/containers/
!/containers/*.def
!/containers/*.md
!/containers/Dockerfile

# Standalone mutation-code application and deliberately maintained fixtures.
!/MutCode/
!/MutCode/Cargo.toml
!/MutCode/Cargo.lock
!/MutCode/README.md
!/MutCode/src/
!/MutCode/src/**/
!/MutCode/src/**/*.rs
!/MutCode/tests/
!/MutCode/tests/**/
!/MutCode/tests/**/*.rs
!/MutCode/tests/fixtures/
!/MutCode/tests/fixtures/**
!/MutCode/containers/
!/MutCode/containers/*.def
!/MutCode/containers/*.sh
!/MutCode/containers/*.md

# Release/build workflows.
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/workflows/*.yaml

# Keep generated artifacts and local settings out of allowed directories too.
target/
target-linux/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!/.env.example
!/.env.sample
!/.env.template
*.pyc
*.pyo
*.rs.bk
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*:Zone.Identifier
